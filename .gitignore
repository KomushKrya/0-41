# Приёмка исходных моделей: сюда кладут сырые GLB от художника (сотни мегабайт),
# из них вырезаются ассеты в assets/models. Сами исходники в репозиторий не идут.
temp/

# Temporary files
*.tmp
*.temp
*.log

# Godot generated translations
*.translation

# Python: конвертер и инструменты запускаются системным питоном, venv нужен только
# для локального MCP-сервера — ни то, ни другое в репозиторий не едет.
__pycache__/
*.pyc
venv/

.obsidian/

# Собранный текст (content/localisation) в репозитории ЕСТЬ и коммитится вместе
# с исходниками. Да, это производная от content/raw, но игра читает именно её, и
# пока сборка лежала в игноре, у всех, кроме автора правки, оставался старый текст.
#
# Значит, поправил content/raw — пересобери и положи результат в тот же коммит:
#     python content/engine/converter/build.py

# Claude Code project config / local MCP server registration
.claude/
.mcp.json
