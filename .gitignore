# Выгрузка ветки main, из которой переносили работу. Это временная копия чужой ветки,
# а не часть проекта: всё нужное из неё уже перенесено в основное дерево.
/0-41-main/

# Черновик сообщения коммита — нужен только на время git commit -F
сообщение-коммита.txt

# Godot generated translations
*.translation

# Собранный текст: генерируется из content/raw конвертером content/engine/converter/build.py.
# В отладочной сборке автозагрузка ContentHotReload собирает его при запуске игры,
# вручную — python content/engine/converter/build.py.
# ВАЖНО: перед экспортом билда конвертер надо прогнать, иначе в .pck не попадёт текст.
/content/localisation/
.obsidian/

# Claude Code project config / local MCP server registration
.claude/
.mcp.json
AGENTS.md

# Сводка миссий для авторов: собирается из content/raw скриптом, в репозитории не хранится.
content/raw/Миссии всех смен.docx

# Обсидиановский волт с джема: к content/raw отношения не имеет, в репозитории не нужен.
