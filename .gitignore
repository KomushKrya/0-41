# Собранный текст генерируется из content/raw конвертером content/engine/converter/build.py.
# Результат хранится в репозитории: чистый клон должен запускаться без локального кеша
# и без обязательного шага генерации перед первым запуском.
.obsidian/

# Запас портретов. В игру идут только те, что переименованы в port_*, — их id
# перечислены в data/employees.json. Остальные лица лежат локально и ждут
# расширения пула: держать 70 МБ неиспользуемых снимков в истории незачем.
assets/portraits/face_*.png
assets/portraits/face_*.png.import

